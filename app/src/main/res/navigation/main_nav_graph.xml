<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/introFragment">

    <fragment
        android:id="@+id/introFragment"
        android:name="rpt.games.transport2147.ui.intro.IntroFragment"
        tools:layout="@layout/fragment_intro"
        android:label="IntroFragment">

        <action
            android:id="@+id/action_introFragment_to_mainMenuFragment"
            app:destination="@id/mainMenuFragment" />
    </fragment>
    <fragment
        android:id="@+id/mainMenuFragment"
        android:name="rpt.games.transport2147.ui.mainmenu.MainMenuFragment"
        tools:layout="@layout/fragment_main_menu"
        android:label="MainMenuFragment">
    </fragment>
    <fragment
        android:id="@+id/historyFragment"
        android:name="rpt.games.transport2147.ui.history.HistoryFragment"
        tools:layout="@layout/fragment_history"
        android:label="HistoryFragment">

        <action
            android:id="@+id/action_historyFragment_to_imageZoomFragment"
            app:destination="@id/imageZoomFragment" />
    </fragment>
    <fragment
        android:id="@+id/imageZoomFragment"
        android:name="rpt.games.transport2147.ui.image.ImageZoomFragment"
        tools:layout="@layout/fragment_image_zoom"
        android:label="ImageZoomFragment">
        <argument
            android:name="image"
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/navigatorFragment"
        android:name="rpt.games.transport2147.ui.navigator.NavigatorFragment"
        tools:layout="@layout/fragment_navigator"
        android:label="NavigatorFragment">

        <action
            android:id="@+id/action_navigatorFragment_to_mainMenuFragment"
            app:destination="@id/mainMenuFragment" />

        <action
            android:id="@+id/action_navigatorFragment_to_mainMenuTwoFragment"
            app:destination="@id/mainMenuTwoFragment" />
    </fragment>
    <fragment
        android:id="@+id/mainMenuTwoFragment"
        android:name="rpt.games.transport2147.ui.mainmenu2.MainMenuTwoFragment"
        tools:layout="@layout/fragment_main_menu_two"
        android:label="MainMenuTwoFragment">
    </fragment>

</navigation>