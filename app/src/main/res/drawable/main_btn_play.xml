<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0C" />
            <stroke android:width="2dp" android:color="#333333" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <item android:state_enabled="true" android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#3300E5FF" />
            <stroke android:width="2dp" android:color="#00E5FF" />
            <corners android:radius="2dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0D0F12" />
            <stroke android:width="2dp" android:color="#00B8CC" />
            <corners android:radius="2dp" />
        </shape>
    </item>

</selector>