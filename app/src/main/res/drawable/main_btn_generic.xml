<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/cyber_bg_pressed" />
            <stroke android:width="2dp" android:color="@color/dlg_button_text" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/cyber_bg_normal" />
            <stroke android:width="2dp" android:color="@color/cyber_border_normal" />
            <corners android:radius="2dp" />
        </shape>
    </item>
</selector>