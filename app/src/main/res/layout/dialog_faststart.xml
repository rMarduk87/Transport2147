<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/dlg.mainLayout"
    android:background="@drawable/bg_cyber_dialog"
    android:theme="@style/Theme.CyberpunkDialog">

    <LinearLayout style="@style/dlg.innerLayout"
        android:padding="8dp">

        <include layout="@layout/include_fontsizechanger"/>
        <include layout="@layout/include_introtitle"/>

        <LinearLayout
            android:id="@+id/dlgFastStart_layContent"
            style="@style/dlg.innerLayout.scrolling.padding"
            android:orientation="vertical" />

        <RadioGroup
            android:id="@+id/dlgFastStart_rdgTemplates"
            style="@style/dlg.radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp" />

        <include layout="@layout/include_okcancel"/>

    </LinearLayout>
</ScrollView>