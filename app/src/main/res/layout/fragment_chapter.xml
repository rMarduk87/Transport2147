<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/frgChapter_scvScroll"
    android:background="@drawable/bkg_chapter_body"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/include_fontsizechanger"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/frgChapter_layContent"
            android:paddingLeft="@dimen/frgChapter_textPadding"
            android:paddingTop="@dimen/frgChapter_textPaddingTopBottom"
            android:paddingRight="@dimen/frgChapter_textPadding"
            android:paddingBottom="@dimen/frgChapter_textPaddingTopBottom"
            android:scrollbars="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>
    </LinearLayout>
</ScrollView>
